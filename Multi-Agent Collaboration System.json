    {
      "parameters": {
        "promptType": "define",
        "text": "You are a Supervisor Agent in a Multi-Agent System.\n\nWhen a user provides a topic, do NOT ask for more information.\n\nYour job is to:\n1. Accept the topic.\n2. Create a research task.\n3. Pass the topic to the Research Agent.\n4. Collect the results.\n5. Pass the results to the Summary Agent.\n6. Pass the summary to the Verification Agent.\n7. Generate a final report.\n\nAlways start processing immediately.\n\nIf the topic is \"Artificial Intelligence in Education\", create a task for researching AI in Education and continue the workflow without asking questions.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        208,
